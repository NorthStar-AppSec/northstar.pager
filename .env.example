BETTERSTACK_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# from `claude setup-token` on a machine where you are logged in to Claude Code
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_MODEL=claude-opus-5-5
# Optional: Better Stack heartbeat URL, so you get an alert if this tool itself dies
HEARTBEAT_URL=
POLL_SECONDS=60
# Optional: let the pager read your logs, so an alert naming an IP comes with what that IP
# did (still active? anything succeeded? what it hit). Better Stack -> Telemetry -> your source ->
# Connect remotely: the host URL, username and password, plus the table name without its suffix.
BETTERSTACK_LOGS_URL=
BETTERSTACK_LOGS_USER=
BETTERSTACK_LOGS_PASSWORD=
# e.g. t123456_production
BETTERSTACK_LOGS_TABLE=
